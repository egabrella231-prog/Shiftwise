rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Catch-all Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSameUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isMemberOfCompany(companyId) {
      return isSignedIn() && (getUserData().company_id == companyId);
    }

    function isAdminOrSupervisorOfCompany(companyId) {
      return isSignedIn() && (getUserData().company_id == companyId) && (getUserData().role == 'admin' || getUserData().role == 'supervisor');
    }

    // Users Collection rules
    match /users/{userId} {
      allow get: if isSignedIn();
      allow create: if isSignedIn() && isSameUser(userId);
      allow update, delete: if isSignedIn() && isSameUser(userId) && (
        // Prevent changing company_id or role if not admin
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'company_id'])
      );
    }

    // Companies Collection rules
    match /companies/{companyId} {
      allow get: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && isMemberOfCompany(companyId);
    }

    // Nesting rules inside companies
    match /companies/{companyId}/employees/{employeeId} {
      allow read: if isSignedIn() && isMemberOfCompany(companyId);
      allow write: if isSignedIn() && isAdminOrSupervisorOfCompany(companyId);
    }

    match /companies/{companyId}/sites/{siteId} {
      allow read: if isSignedIn() && isMemberOfCompany(companyId);
      allow write: if isSignedIn() && isAdminOrSupervisorOfCompany(companyId);
    }

    match /companies/{companyId}/roster/{rosterId} {
      allow read: if isSignedIn() && isMemberOfCompany(companyId);
      allow write: if isSignedIn() && isAdminOrSupervisorOfCompany(companyId);
    }

    match /companies/{companyId}/payroll_settings/{docId} {
      allow read: if isSignedIn() && isMemberOfCompany(companyId);
      allow write: if isSignedIn() && isAdminOrSupervisorOfCompany(companyId);
    }
  }
}
